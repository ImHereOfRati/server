# Grafana Cloud 자격증명 — alloy 컨테이너가 sys.env()로 읽는다.
# 읽는 컨테이너: alloy
#
# 앱(dsko)에는 넣지 않는다. 앱은 트레이스를 같은 네트워크의 alloy로만 보내고
# Grafana Cloud와 직접 통신하지 않는다.

# 로그 (Loki)
GRAFANA_CLOUD_LOKI_ENDPOINT=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_LOKI_API_KEY=

# 메트릭 (Prometheus remote write)
GRAFANA_CLOUD_PROM_ENDPOINT=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_PROM_API_KEY=

# 트레이스 (Tempo, OTLP)
GRAFANA_CLOUD_TEMPO_ENDPOINT=
GRAFANA_CLOUD_TEMPO_USER=
GRAFANA_CLOUD_TEMPO_API_KEY=

# 아래 2개는 현재 alloy-config.alloy.template이 참조하지 않는다.
# Alertmanager 연동을 붙일 때를 위해 자리만 남겨 둔다.
GRAFANA_CLOUD_ALERTMANAGER_ENDPOINT=
GRAFANA_CLOUD_ALERTMANAGER_USER=
