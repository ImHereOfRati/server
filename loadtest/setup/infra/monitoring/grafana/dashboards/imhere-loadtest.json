{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Application",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "up{job=\"imhere\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": 0}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"}
    },
    {
      "type": "timeseries",
      "title": "HTTP RPS",
      "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0},
      "targets": [{"expr": "imhere:http_requests_per_second", "legendFormat": "requests/s", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "HTTP 5xx",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "imhere:http_5xx_per_second", "legendFormat": "5xx/s", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]}}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "HTTP P95",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "imhere:http_p95_seconds", "legendFormat": "p95", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "JVM CPU",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "process_cpu_usage{job=\"imhere\"} * 100", "legendFormat": "CPU", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "HikariCP Pending",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [{"expr": "imhere:hikaricp_pending", "legendFormat": "pending", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "type": "logs",
      "title": "Application Errors",
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 16},
      "targets": [{"datasource": {"type": "loki", "uid": "loadtest-loki"}, "expr": "{service=\"dsko\"} | json | detected_level=~\"error|warn\"", "refId": "A"}],
      "options": {"showTime": true, "showLabels": false, "wrapLines": true, "sortOrder": "Descending"}
    },
    {
      "type": "logs",
      "title": "Nginx Access Logs",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 26},
      "targets": [{"datasource": {"type": "loki", "uid": "loadtest-loki"}, "expr": "{service=\"nginx\"}", "refId": "A"}],
      "options": {"showTime": true, "showLabels": true, "wrapLines": true, "sortOrder": "Descending"}
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["imhere", "load-test", "rate-limit"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "timepicker": {"refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]},
  "timezone": "browser",
  "title": "ImHere Load Test",
  "uid": "imhere-loadtest",
  "version": 2
}
