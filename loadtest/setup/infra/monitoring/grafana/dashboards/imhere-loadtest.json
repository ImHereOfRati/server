  "panels": [
    {"type":"stat","title":"서비스 가동 상태","description":"load-test App Alloy가 수집한 up 상태","gridPos":{"h":4,"w":6,"x":0,"y":0},"targets":[{"expr":"up{instance=\"iamhere-server-container:4861\"}","refId":"A"}],"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"DOWN","color":"red"},"1":{"text":"UP","color":"green"}}}],"thresholds":{"mode":"absolute","steps":[{"color":"red","value":0},{"color":"green","value":1}]},"color":{"mode":"thresholds"}},"overrides":[]},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background","graphMode":"none"}},
    {"type":"stat","title":"CPU 사용률","description":"프로세스 CPU 사용 비율","gridPos":{"h":4,"w":6,"x":6,"y":0},"targets":[{"expr":"process_cpu_usage{instance=\"iamhere-server-container:4861\"} * 100","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100,"thresholds":{"mode":"absolute","steps":[{"color":"green","value":0},{"color":"yellow","value":70},{"color":"red","value":90}]},"color":{"mode":"thresholds"}},"overrides":[]},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background","graphMode":"area"}},
    {"type":"timeseries","title":"실제 처리 HTTP RPS","description":"k6 도착률이 아니라 앱이 응답 완료한 HTTP 요청률. 30초 창으로 단계 변화를 빠르게 반영한다.","gridPos":{"h":8,"w":12,"x":12,"y":0},"targets":[{"expr":"sum by(outcome) (rate(http_server_requests_seconds_count{instance=\"iamhere-server-container:4861\"}[30s]))","legendFormat":"{{outcome}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]}},
    {"type":"timeseries","title":"HTTP 평균 응답시간","description":"Spring Security HTTP 필터 통과 평균 응답시간","gridPos":{"h":8,"w":12,"x":0,"y":4},"targets":[{"expr":"rate(spring_security_http_secured_requests_seconds_sum{instance=\"iamhere-server-container:4861\"}[1m]) / rate(spring_security_http_secured_requests_seconds_count{instance=\"iamhere-server-container:4861\"}[1m])","legendFormat":"평균 응답시간","refId":"A"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
    {"type":"timeseries","title":"JVM 메모리 사용량","description":"Heap/Non-heap 메모리 사용량","gridPos":{"h":8,"w":12,"x":12,"y":8},"targets":[{"expr":"sum by(area) (jvm_memory_used_bytes{instance=\"iamhere-server-container:4861\"})","legendFormat":"{{area}} used","refId":"A"},{"expr":"sum by(area) (jvm_memory_max_bytes{instance=\"iamhere-server-container:4861\"})","legendFormat":"{{area}} max","refId":"B"}],"fieldConfig":{"defaults":{"unit":"bytes"},"overrides":[]}},
    {"type":"timeseries","title":"GC 오버헤드 및 일시정지","description":"GC 오버헤드 5/10% 임계값","gridPos":{"h":8,"w":12,"x":0,"y":12},"targets":[{"expr":"jvm_gc_overhead{instance=\"iamhere-server-container:4861\"} * 100","legendFormat":"GC overhead (%)","refId":"A"},{"expr":"rate(jvm_gc_pause_seconds_sum{instance=\"iamhere-server-container:4861\"}[1m])","legendFormat":"GC pause","refId":"B"}],"fieldConfig":{"defaults":{"unit":"percent","thresholds":{"mode":"absolute","steps":[{"color":"green","value":0},{"color":"yellow","value":5},{"color":"red","value":10}]}},"overrides":[{"matcher":{"id":"byName","options":"GC pause"},"properties":[{"id":"unit","value":"s"}]}]}},
    {"type":"timeseries","title":"JVM 스레드 상태","description":"blocked 증가와 live thread 수","gridPos":{"h":8,"w":12,"x":12,"y":16},"targets":[{"expr":"jvm_threads_states_threads{instance=\"iamhere-server-container:4861\"}","legendFormat":"{{state}}","refId":"A"},{"expr":"jvm_threads_live_threads{instance=\"iamhere-server-container:4861\"}","legendFormat":"live (total)","refId":"B"}],"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]}},
    {"type":"timeseries","title":"HikariCP 커넥션 풀 상태","description":"pending 증가는 DB 병목 신호","gridPos":{"h":8,"w":12,"x":0,"y":20},"targets":[{"expr":"hikaricp_connections_active{instance=\"iamhere-server-container:4861\"}","legendFormat":"active","refId":"A"},{"expr":"hikaricp_connections_idle{instance=\"iamhere-server-container:4861\"}","legendFormat":"idle","refId":"B"},{"expr":"hikaricp_connections_pending{instance=\"iamhere-server-container:4861\"}","legendFormat":"pending","refId":"C"},{"expr":"hikaricp_connections{instance=\"iamhere-server-container:4861\"}","legendFormat":"total","refId":"D"}],"fieldConfig":{"defaults":{"unit":"short"},"overrides":[{"matcher":{"id":"byName","options":"pending"},"properties":[{"id":"color","value":{"fixedColor":"red","mode":"fixed"}}]}]}},
    {"type":"timeseries","title":"HikariCP 타임아웃·획득 시간","description":"timeout 발생 및 acquire 0.5/1초 임계값","gridPos":{"h":8,"w":12,"x":12,"y":24},"targets":[{"expr":"rate(hikaricp_connections_timeout_total{instance=\"iamhere-server-container:4861\"}[1m])","legendFormat":"timeout","refId":"A"},{"expr":"hikaricp_connections_acquire_seconds_max{instance=\"iamhere-server-container:4861\"}","legendFormat":"acquire max","refId":"B"}],"fieldConfig":{"defaults":{"unit":"s","thresholds":{"mode":"absolute","steps":[{"color":"green","value":0},{"color":"yellow","value":0.5},{"color":"red","value":1}]}},"overrides":[{"matcher":{"id":"byName","options":"timeout"},"properties":[{"id":"unit","value":"cps"}] }]}},
    {"type":"logs","title":"ERROR / WARN 로그","description":"부하 중 애플리케이션 오류와 Hikari 경고","gridPos":{"h":10,"w":24,"x":0,"y":32},"targets":[{"datasource":{"type":"loki","uid":"loadtest-loki"},"expr":"{service=\"dsko\"} | json | detected_level=~\"error|warn\"","refId":"A"}],"options":{"showTime":true,"showLabels":false,"showCommonLabels":false,"wrapLines":true,"sortOrder":"Descending"}},
    {"type":"timeseries","title":"최근 로그 레벨별 발생률","gridPos":{"h":8,"w":12,"x":0,"y":42},"targets":[{"datasource":{"type":"loki","uid":"loadtest-loki"},"expr":"sum by(detected_level) (rate({service=\"dsko\"} | json [1m]))","legendFormat":"{{detected_level}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]}},
    {"type":"timeseries","title":"HTTP P95 응답시간","description":"Spring Boot HTTP histogram 기준 P95. TraceQL metrics 문법에 의존하지 않는다.","gridPos":{"h":8,"w":12,"x":12,"y":42},"targets":[{"datasource":{"type":"prometheus","uid":"loadtest-prom"},"expr":"histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{instance=\"iamhere-server-container:4861\"}[1m])))","legendFormat":"HTTP P95","refId":"A"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
    {"type":"table","title":"최근 트레이스","gridPos":{"h":10,"w":12,"x":0,"y":50},"targets":[{"datasource":{"type":"tempo","uid":"loadtest-tempo"},"queryType":"traceql","query":"{ resource.service.name = \"imhere\" } | select(name, duration, status, rootServiceName)","limit":20,"refId":"A"}],"options":{"showHeader":true}},
    {"type":"table","title":"에러 트레이스","gridPos":{"h":10,"w":12,"x":12,"y":50},"targets":[{"datasource":{"type":"tempo","uid":"loadtest-tempo"},"queryType":"traceql","query":"{ resource.service.name = \"imhere\" && status = error } | select(name, duration, status, rootServiceName)","limit":20,"refId":"A"}],"options":{"showHeader":true}}
