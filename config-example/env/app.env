# 앱 코어: 프로파일 / DB / JWT / 관리자·보안
# 읽는 컨테이너: dsko
#
# 여기 있는 키는 application.yaml에 기본값이 없다. 하나라도 비면 앱이
# 기동 단계에서 실패한다.

# 반드시 prod. 이 값이 있어야 application.yaml의 prod 문서가 활성화된다.
SPRING_PROFILES_ACTIVE=

# 가비아 MySQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# HikariCP maximum-pool-size. 가비아 플랜의 최대 커넥션 수를 넘지 않게 잡는다.
DB_POOL_SIZE=

# actuator base-path. 추측 불가능한 문자열로 난독화한다.
# infra/nginx/nginx.conf.template과 infra/alloy/alloy-config.alloy.template이
# 같은 값을 쓰므로 셋이 항상 일치해야 한다.
MGMT_BASE_PATH=
# logback rolling policy의 파일명 접두. 예: logs/imhere.log
LOG_FILE=

# JWT 서명 키. HS 계열이므로 충분히 긴 랜덤 문자열이어야 한다.
# 교체하면 기존 리프레시 토큰이 전부 무효화된다.
JWT_SECRET=

# 인증 없이 통과시킬 경로 목록(콤마 구분).
SECURITY_WHITELIST=
# 관리자 계정 식별자.
ADMIN_ID=
# /admin/** 접근을 허용할 IP 목록(콤마 구분).
# 비면 prod 프로파일이 fail-closed로 기동을 거부한다(SecurityConfig).
ADMIN_ALLOWED_IPS=
