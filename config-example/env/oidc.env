# 소셜 로그인 클라이언트 ID (= ID 토큰의 aud 클레임)
# 읽는 컨테이너: dsko
#
# 이 파일의 키는 전부 옵셔널이다. 빈 항목은 OIDCProperties가 걸러내므로
# 쓰지 않는 플랫폼은 비워 두면 되고, 비어도 앱은 기동한다.
# 다만 해당 플랫폼 로그인은 aud 불일치로 전량 실패한다.

KAKAO_CLIENT_ID=

GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# Apple: iOS는 bundle ID, 웹은 Services ID가 aud로 들어온다.
APPLE_CLIENT_ID=
APPLE_SERVICE_ID=
