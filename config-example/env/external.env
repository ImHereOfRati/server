# 외부 서비스 연동 자격증명
# 읽는 컨테이너: dsko

# Firebase 서비스 계정 키의 컨테이너 내부 경로.
# deploy-app이 ./secrets/imhereFirebaseKey.json을 /app/secrets/에 마운트한다.
FIREBASE_PATH=

# NCP Maps(지오코딩/역지오코딩) — /api/maps/* 프록시가 쓴다.
# 기본값이 없으므로 비우면 기동에 실패한다.
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# Naver 검색 API(장소 검색) — 위와 동일.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# SOLAPI(문자 발송)
SOLAPI_SENDER=
SOLAPI_API_KEY=
SOLAPI_API_SECRET=

# Discord 알림 웹훅
DISCORD_WEBHOOK_ERROR_SERVER=
DISCORD_WEBHOOK_ERROR_CLIENT=
DISCORD_WEBHOOK_OTT=
