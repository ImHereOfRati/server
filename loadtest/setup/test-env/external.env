SOLAPI_SENDER=01000000000
SOLAPI_API_KEY=imhere-test-solapi-api-key
SOLAPI_API_SECRET=imhere-test-solapi-api-secret
FIREBASE_PATH=file:/app/secrets/imhereFirebaseKey.json
NAVER_MAP_CLIENT_ID=imhere-test-naver-map-client-id
NAVER_MAP_CLIENT_SECRET=imhere-test-naver-map-client-secret
NAVER_SEARCH_CLIENT_ID=imhere-test-naver-search-client-id
NAVER_SEARCH_CLIENT_SECRET=imhere-test-naver-search-client-secret
DISCORD_WEBHOOK_ERROR_SERVER=http://127.0.0.1:9/test-server-webhook
DISCORD_WEBHOOK_ERROR_CLIENT=http://127.0.0.1:9/test-client-webhook
SECURITY_WHITELIST=/api/auth,/api/auth/refresh,/api/terms,/swagger-ui/**,/docs/**
CORS_ALLOWED_ORIGINS=http://localhost
